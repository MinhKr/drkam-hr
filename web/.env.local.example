# Sao chép file này thành .env.local rồi điền giá trị lấy từ Supabase:
# Project Settings → API Keys / Data API
#
# App dùng project Supabase RIÊNG, bảng nằm trong schema public.
# Hướng dẫn dựng project từ đầu: web/README-supabase.md
#
# Khoá công khai nhận cả hai dạng: sb_publishable_... (project mới)
# hoặc eyJhbGciOi... (project cũ).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Để trống cả hai dòng trên thì app chạy ở chế độ xem trước: giao diện và
# danh mục hiển thị đầy đủ (đọc từ src/data/catalogs.json) nhưng không ghi
# được gì. Dùng khi chưa có project, hoặc khi muốn chắc chắn không đụng
# vào cơ sở dữ liệu nào.

# SUPABASE_SERVICE_ROLE_KEY — không cần nữa. Khoá toàn quyền này chỉ dùng cho
# script nạp dữ liệu cũ (tools/import_excel.py), mà việc đó đã cắt khỏi phạm vi
# ngày 17/08. Nếu sau này cần dùng lại: chỉ để trong máy, không đưa lên Vercel.
